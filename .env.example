# Supabase Postgres connection string
# Get from: https://supabase.com/dashboard → your project → Connect → ORMs / Drizzle
# Use the TRANSACTION POOLER URI (port 6543) — required for serverless/Vercel.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# OpenRouter API key
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: which model to use. Any model id OpenRouter serves.
# Default: anthropic/claude-sonnet-4
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional: your deployed site URL, sent to OpenRouter as attribution.
OPENROUTER_SITE_URL=http://localhost:3000

# Optional: protects the auto-tracking cron endpoint (GET /api/track).
# On Vercel, set this env var and Vercel Cron will send it automatically.
CRON_SECRET=
